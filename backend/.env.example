# Copy this file to .env (same folder) to override defaults. All values are optional.
PORT=5000
FLASK_DEBUG=1
# CORS_ORIGINS=http://localhost:5000,http://localhost:8000

# --- Real Trustpilot data (leave unset to keep using the built-in mock reviews) ---
# TRUSTPILOT_API_KEY=your_key
# TRUSTPILOT_BUSINESS_ID=your_business_unit_id
# TRUSTPILOT_API_BASE_URL=https://api.trustpilot.com/v1

# --- Send triggered workflows to an external mock API (e.g. Postman Mock Server) ---
# WORKFLOW_TRIGGER_MODE=external
# EXTERNAL_WORKFLOW_API_URL=https://your-mock-server.mock.pstmn.io/workflows

# URL scraping is enabled locally by default; keep it disabled on public deployments
# until destination allowlisting and SSRF protections are implemented.
ENABLE_WEB_SCRAPING=true
